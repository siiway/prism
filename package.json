{
  "name": "prism",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "bun run build && wrangler deploy",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:migrate": "wrangler d1 migrations apply prism-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply prism-db --remote",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "format": "prettier -c worker src shared docs",
    "format:fix": "prettier -w worker src shared docs"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.73.8",
    "@fluentui/react-icons": "^2.0.325",
    "@noble/post-quantum": "^0.6.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "@tanstack/react-query": "^5.100.9",
    "@types/qrcode": "^1.5.6",
    "dompurify": "^3.4.2",
    "hono": "^4.12.17",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "marked": "^18.0.3",
    "openpgp": "^6.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^16.6.6",
    "react-router-dom": "^7.15.0",
    "worker-mailer": "^1.2.1",
    "zustand": "^5.0.13"
  },
  "overrides": {
    "lodash": "^4.18.1"
  },
  "pnpm": {
    "overrides": {
      "lodash": "^4.18.1"
    }
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.36.0",
    "@cloudflare/workers-types": "^4.20260506.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "mermaid": "^11.14.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.10",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "wrangler": "^4.88.0"
  }
}
