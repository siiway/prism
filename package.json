{
  "name": "prism",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "vite",
    "dev:staging": "CLOUDFLARE_ENV=staging vite",
    "dev:preview": "CLOUDFLARE_ENV=preview vite",
    "build": "tsc -b && vite build",
    "deploy": "bun run build && wrangler deploy",
    "deploy:staging": "bun scripts/deploy-env.mjs staging",
    "deploy:preview": "bun scripts/deploy-env.mjs preview",
    "lint": "eslint .",
    "test": "bun test",
    "preview": "vite preview",
    "db:migrate": "wrangler d1 migrations apply prism-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply prism-db --remote",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging --config wrangler.jsonc",
    "db:migrate:preview": "wrangler d1 migrations apply DB --remote --env preview --config wrangler.jsonc",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "format": "prettier -c worker src shared docs tests",
    "format:fix": "prettier -w worker src shared docs tests"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.6",
    "@fluentui/react-icons": "^2.0.338",
    "@noble/post-quantum": "^0.6.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@tanstack/react-query": "^5.102.1",
    "@types/qrcode": "^1.5.6",
    "dompurify": "^3.4.14",
    "hono": "^4.13.3",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "ipaddr.js": "^2.5.0",
    "marked": "^18.0.10",
    "openpgp": "^6.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^16.6.6",
    "react-router-dom": "^7.18.2",
    "worker-mailer": "^1.2.1",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "lodash": "^4.18.1"
  },
  "pnpm": {
    "overrides": {
      "lodash": "^4.18.1"
    }
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "mermaid": "^11.17.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "wrangler": "^4.125.0"
  }
}
