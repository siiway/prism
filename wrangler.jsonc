{
  "name": "prism",
  // Source pointer for the @cloudflare/vite-plugin, which validates this at
  // config-load time. Vite then builds the worker into dist/prism/index.js
  // and writes a deploy-ready dist/prism/wrangler.json next to it.
  // Production deploys MUST use that generated config instead of this one
  // (otherwise wrangler re-bundles the source and skips Vite's SSR work).
  // See scripts/build.sh — it copies the generated config back here so a
  // plain `wrangler deploy` from the build directory picks up the right
  // bundle without needing custom flags in the Cloudflare dashboard.
  "main": "worker/index.ts",
  "compatibility_date": "2024-11-01",
  // Keep global fetch on public Internet routing, including for this zone, so
  // same-zone requests cannot bypass Cloudflare's front door and its controls.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // capjs-core (embedded Cap captcha) lazily `import()`s esbuild and
  // javascript-obfuscator for instrumentation obfuscation level >= 4. Those are
  // Node-native and cannot be bundled for the Worker runtime. We pin the
  // embedded Cap instrumentation to level <= 3, which never touches them, so
  // aliasing both to an empty stub keeps them out of the bundle without losing
  // any reachable functionality.
  "alias": {
    "esbuild": "./worker/lib/stubs/empty.js",
    "javascript-obfuscator": "./worker/lib/stubs/empty.js",
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // Default is "auto-trailing-slash", which auto-resolves "/" to
    // "/index.html" and serves the prebuilt template before the worker
    // even runs — defeating SSR. "none" disables that implicit HTML
    // routing; explicitly-requested files (e.g. /index.html, /favicon.svg,
    // /assets/index-XXX.js) are still served from the bundle as static.
    "html_handling": "none",
  },
  "observability": {
    "enabled": true,
  },
  // D1 Database
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prism-db",
      "database_id": "5790c075-635c-470f-a166-8b9f145ec311",
      "migrations_dir": "worker/db/migrations",
    },
  ],
  // KV Namespaces
  "kv_namespaces": [
    {
      "binding": "KV_SESSIONS",
      "id": "e76739c67270401e8f7b5283cf22d2dd",
    },
    {
      "binding": "KV_CACHE",
      "id": "db4d8187fc3f48eabc412a3f5654fa69",
    },
  ],
  // R2 Bucket
  /*
  "r2_buckets": [
    {
      "binding": "R2_ASSETS",
      "bucket_name": "prism-assets",
    },
  ],
  */
  // Cloudflare Secrets Store. After creating a 32-byte
  // base64url-encoded AES-GCM key in the dashboard, redeploy and use
  // Admin Panel → Settings → Danger Zone → "Migrate secrets to Secret
  // Store" to encrypt existing OAuth client/source secrets in D1.
  // Generate the key with e.g.
  //   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
  "secrets_store_secrets": [
    {
      "binding": "SECRETS_KEY",
      "store_id": "5ffcfaec1c6c4599989fb6a761d9583f",
      "secret_name": "prism-secrets-key",
    },
  ],
  // Environment variables (non-secret)
  "vars": {
    "APP_URL": "https://prism.siiway.org",
    // Comma / semicolon / whitespace separated list of usernames
    // that cannot be deleted. Leave empty to disable.
    "LOCKDOWN_USERS": "",
    // Comma / semicolon / whitespace separated list of team names
    // that cannot be deleted. Leave empty to disable.
    "LOCKDOWN_TEAMS": "",
    // Admin Panel → Database (direct D1 access). OFF unless you turn it on:
    // empty, "off" or anything unrecognised removes the surface entirely
    // (endpoints 404, the tab disappears). "read-only" allows browsing and
    // SELECT but refuses every write. "full" is unrestricted — except the
    // audit log, which is append-only from this console at every setting.
    "D1_CONSOLE": "",
    // The key-value browser in the same panel. Same values as D1_CONSOLE;
    // leave empty to follow whatever D1_CONSOLE is set to (so both are off
    // by default).
    "KV_CONSOLE": "",
  },
  "routes": [
    {
      "pattern": "prism.siiway.org",
      "custom_domain": true,
    },
  ],
  // Re-verify domains every 6 hours
  "triggers": {
    "crons": ["0 */6 * * *"],
  },
  // ── Non-production environments ─────────────────────────────────────────────
  // Separate Workers with their own isolated D1 + KV so testing never touches
  // production data. All resources live on the same (SiiWay) account as prod.
  //
  //   Deploy:   bun run deploy:staging      (CLOUDFLARE_ENV=staging build + deploy)
  //   Migrate:  bun run db:migrate:staging  (apply migrations to the staging D1)
  //   Dev:      bun run dev:staging         (vite dev with the staging bindings)
  //
  // The environment is chosen at build time via CLOUDFLARE_ENV (the package.json
  // scripts set it): the Vite plugin resolves one environment per build and
  // emits an already-environment-specific dist/prism/wrangler.json, so deploys
  // use that generated config rather than `wrangler deploy --env <name>`.
  //
  // Inheritable keys (main, compatibility_date/flags, assets, observability) are
  // deliberately not repeated — Wrangler inherits them from the top level.
  // Bindings, vars and routes are per-environment and are NOT inherited, so each
  // environment restates them. No custom-domain route is set, so each Worker is
  // reachable at https://<name>.siiway.workers.dev.
  //
  // SECRETS_KEY: each environment has its own Secret Store entry (prod,
  // staging, preview all use distinct keys), so a leak or slip in a throwaway
  // non-prod environment can never expose data encrypted under another key.
  // All three entries live in the same store; only secret_name differs.
  "env": {
    "staging": {
      "name": "prism-staging",
      // Pin the account so the deploy:/db:migrate: scripts resolve without a
      // CLOUDFLARE_ACCOUNT_ID env var on multi-account credentials.
      "account_id": "a55f78dc73452cce2da2a69798c86db3",
      "workers_dev": true,
      // Clear the inherited production custom-domain route so this Worker only
      // ever answers on its own .workers.dev subdomain, never prism.siiway.org.
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "prism-staging-db",
          "database_id": "4963fd88-5b5b-4809-b481-71473ed95743",
          "migrations_dir": "worker/db/migrations",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "KV_SESSIONS",
          "id": "58e1059ced764328aa5493d077e2c576",
        },
        {
          "binding": "KV_CACHE",
          "id": "9e32bbd549e24f6aa6ff6b9f3b50b40a",
        },
      ],
      "secrets_store_secrets": [
        {
          "binding": "SECRETS_KEY",
          "store_id": "5ffcfaec1c6c4599989fb6a761d9583f",
          "secret_name": "prism-staging-secrets-key",
        },
      ],
      "vars": {
        "APP_URL": "https://prism-staging.siiway.workers.dev",
      },
      // Non-prod does not run the scheduled domain re-verification.
      "triggers": {
        "crons": [],
      },
    },
    "preview": {
      "name": "prism-preview",
      "account_id": "a55f78dc73452cce2da2a69798c86db3",
      "workers_dev": true,
      // Clear the inherited production custom-domain route (see staging above).
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "prism-preview-db",
          "database_id": "5f8e6104-03f7-4b3c-b7c9-55e8ca5051a3",
          "migrations_dir": "worker/db/migrations",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "KV_SESSIONS",
          "id": "d1f4dd9e67e74f1fb883c061fbb29e0e",
        },
        {
          "binding": "KV_CACHE",
          "id": "2b3121cba2d84a5c83ba72059a9e17b9",
        },
      ],
      "secrets_store_secrets": [
        {
          "binding": "SECRETS_KEY",
          "store_id": "5ffcfaec1c6c4599989fb6a761d9583f",
          "secret_name": "prism-preview-secrets-key",
        },
      ],
      "vars": {
        "APP_URL": "https://prism-preview.siiway.workers.dev",
      },
      "triggers": {
        "crons": [],
      },
    },
  },
}
