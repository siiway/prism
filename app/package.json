{
  "name": "prism",
  "version": "0.0.1",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "vite",
    "prepare": "bun scripts/hooks.ts",
    "setup": "bun scripts/setup.ts",
    "build": "bun scripts/build.ts",
    "notice": "vite build && bun scripts/notice.ts",
    "deploy": "bun scripts/deploy.ts",
    "lint": "bun --bun eslint .",
    "typecheck": "tsc -p src/web && tsc -p src/worker && tsc -p scripts && tsc -p tests",
    "check:i18n": "bun scripts/check-translations.ts",
    "check:notice": "vite build && bun scripts/notice.ts --check",
    "check": "bun run typecheck && bun run lint && bun run format && bun run test && bun run check:i18n && bun run check:notice",
    "test": "bun test",
    "preview": "vite preview",
    "db:migrate": "wrangler d1 migrations apply prism-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply prism-db --remote",
    "format": "cd .. && prettier -c . --ignore-path .gitignore --ignore-path app/.prettierignore",
    "format:fix": "cd .. && prettier -w . --ignore-path .gitignore --ignore-path app/.prettierignore"
  },
  "dependencies": {
    "@cap.js/wasm": "^0.0.7",
    "@cap.js/widget": "^0.1.58",
    "@fluentui/react-components": "^9.75.0",
    "@fluentui/react-icons": "^2.0.345",
    "@noble/post-quantum": "^0.6.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@tanstack/react-query": "^5.105.1",
    "@types/qrcode": "^1.5.6",
    "capjs-core": "^0.1.6",
    "dompurify": "^3.4.17",
    "hono": "^4.13.16",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "marked": "^18.1.2",
    "openpgp": "^6.3.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^16.6.6",
    "react-router-dom": "^7.18.5",
    "worker-mailer": "^1.3.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "^10.0.1",
    "@j178/prek": "0.5.7",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "wrangler": "^4.156.1"
  }
}
