{
  // The tests run under Bun and import both the app and the Worker, so they
  // get the app's settings with Bun's types, the app's globals and the
  // Worker's Env.
  "extends": "../src/web/tsconfig.json",
  "compilerOptions": {
    "types": ["bun", "vite/client"],
    // As in src/worker/tsconfig.json, which the Worker code here is written for.
    "noUnusedParameters": false,
    // Bun runs TypeScript directly, so constructor parameter properties are fine.
    "erasableSyntaxOnly": false
  },
  "include": [
    ".",
    "../src/worker/env.d.ts",
    "../src/web/search-index.d.ts",
    "../src/web/entry-client.tsx"
  ]
}
